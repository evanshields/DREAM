// DREAM AI - Phase 1 Optimized Schema for Supabase
// Cost-Optimized + PRD Compliant
// Version: 1.0
// Database: Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Supabase connection string
}

// ============================================================================
// ENUMS (From PRD Section 10.2)
// ============================================================================

enum PropertyType {
  MULTIFAMILY
  SINGLE_FAMILY
  STUDENT_HOUSING
  SENIOR_HOUSING
  MOBILE_HOME_PARK
  MIXED_USE
  OTHER
}

enum PropertyClass {
  A
  B
  C
  D
}

enum SourceType {
  BROKER
  DIRECT_OWNER
  AUCTION
  WHOLESALER
  NETWORK
  LOOPNET_COSTAR
  OTHER
}

enum HowReceived {
  EMAIL
  PHONE
  IN_PERSON
  WEBSITE
  REFERRAL
  OTHER
}

enum MarketStatus {
  LISTED
  OFF_MARKET
  PRE_MARKET
  POCKET_LISTING
  REO
}

enum DealStage {
  NEW
  SCREENING
  BOE_ANALYSIS
  FULL_UW
  LOI
  DUE_DILIGENCE
  CLOSING
  CLOSED
  PASSED
  DEAD
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum DocumentType {
  OFFERING_MEMORANDUM
  T12_STATEMENT
  RENT_ROLL
  LEASING_REPORT
  CONCESSIONS_REPORT
  AGED_RECEIVABLES
  CAPITAL_EXPENDITURE_REPORT
  LOAN_DOCUMENTS
  PROPERTY_PHOTO
  SITE_PLAN
  FLOOR_PLAN
  INSPECTION_REPORT
  APPRAISAL
  PRIOR_APPRAISAL
  MARKET_STUDY
  ENVIRONMENTAL_REPORT
  TITLE_REPORT
  ORIGINAL_PLANS
  CONSTRUCTION_BUDGET
  PERMITS
  ENGINEERING_REPORT
  OTHER
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ExtractionJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum StorageProvider {
  SUPABASE  // Changed from S3 to SUPABASE
  S3
  GCS
  LOCAL
}

// ============================================================================
// ORGANIZATION & USER MANAGEMENT
// ============================================================================

model Organization {
  id                String   @id @default(uuid())
  name              String   @db.VarChar(200)
  subscriptionTier  String   @default("FREE") @db.VarChar(50)
  settings          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  users             User[]
  deals             Deal[]
  tags              Tag[]           // Normalized tags

  @@map("organizations")
  @@index([id])
}

model User {
  id             String   @id @default(uuid())
  organizationId String
  email          String   @unique @db.VarChar(255)
  name           String?  @db.VarChar(200)
  role           String   @default("ANALYST") @db.VarChar(50)
  preferences    Json     @default("{}")
  createdAt      DateTime @default(now())

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealsCreated   Deal[]       @relation("DealCreator")
  corrections    ExtractionCorrection[]

  @@index([organizationId])
  @@index([email])
  @@map("users")
}

// ============================================================================
// DEAL MANAGEMENT (Optimized for Cost)
// ============================================================================

model Deal {
  id             String     @id @default(uuid())
  organizationId String
  createdById    String
  
  // Property Identification (Optimized VARCHAR sizes)
  propertyName   String     @db.VarChar(100)  // Was 200, optimized
  addressStreet  String?    @db.VarChar(150)  // Was 200, optimized
  addressCity    String?    @db.VarChar(100)   // Was 100, kept
  addressState   String?    @db.Char(2)
  addressZip     String?    @db.VarChar(10)
  latitude       Decimal?   @db.Decimal(10, 8)
  longitude      Decimal?  @db.Decimal(11, 8)
  
  // Property Characteristics
  propertyType   PropertyType @default(MULTIFAMILY)
  propertyClass  PropertyClass?
  yearBuilt      Int?
  units          Int?
  totalSf        Int?
  lotSizeAcres   Decimal?   @db.Decimal(10, 2)
  parkingSpaces  Int?
  
  // Financial Overview
  askingPrice    Decimal?   @db.Decimal(15, 2)
  pricePerUnit   Decimal?   @db.Decimal(12, 2)  // Generated column
  occupancy      Decimal?   @db.Decimal(5, 4)   // 0-1 range
  noiInPlace     Decimal?   @db.Decimal(15, 2)
  noiProForma    Decimal?   @db.Decimal(15, 2)
  capRateInPlace Decimal?   @db.Decimal(5, 4)    // Generated column
  
  // Source Information (Optimized VARCHAR sizes)
  sourceType     SourceType @default(BROKER)
  sourceName     String?    @db.VarChar(100)    // Was 200, optimized
  sourceCompany  String?    @db.VarChar(100)     // Was 200, optimized
  sourceEmail    String?    @db.VarChar(200)
  sourcePhone    String?    @db.VarChar(20)
  howReceived    HowReceived @default(EMAIL)
  marketStatus   MarketStatus @default(LISTED)
  
  // Workflow
  stage          DealStage  @default(NEW)
  priority       Priority   @default(MEDIUM)
  assignedTo     String?
  
  // Metadata (Optimized: TEXT -> VARCHAR with limit)
  notes          String?   @db.VarChar(5000)    // Was TEXT, limited to 5K
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  
  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("DealCreator", fields: [createdById], references: [id])
  documents      Document[]
  extractionJobs ExtractionJob[]
  dealTags       DealTag[]     // Normalized tags (junction table)

  @@index([organizationId])
  @@index([stage])
  @@index([createdAt(sort: Desc)])
  @@index([organizationId, stage])  // Composite index for common queries
  @@index([organizationId, createdAt(sort: Desc)])  // Composite index
  @@map("deals")
}

// ============================================================================
// TAGS (Normalized for Cost Optimization)
// ============================================================================

model Tag {
  id             String   @id @default(uuid())
  organizationId String
  name           String   @db.VarChar(50)  // Limit tag length
  color          String?  @db.VarChar(7)    // Hex color
  createdAt      DateTime @default(now())

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealTags       DealTag[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("tags")
}

model DealTag {
  dealId String
  tagId  String

  // Relations
  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([dealId, tagId])
  @@index([dealId])
  @@index([tagId])
  @@map("deal_tags")
}

// ============================================================================
// DOCUMENTS (Optimized: Reference extraction data, don't duplicate)
// ============================================================================

model Document {
  id                      String            @id @default(uuid())
  dealId                  String
  uploadedBy              String
  
  // File Info (Optimized VARCHAR sizes)
  filename                String            @db.VarChar(255)
  originalFilename        String            @db.VarChar(255)
  mimeType                String            @db.VarChar(100)
  sizeBytes               BigInt
  storagePath             String            @db.VarChar(500)
  storageProvider         StorageProvider   @default(SUPABASE)  // Changed from S3
  
  // Classification
  documentType            DocumentType?
  classificationConfidence Int?
  classificationModel     String?           @db.VarChar(50)
  
  // Processing Status
  processingStatus        ProcessingStatus  @default(PENDING)
  processingStartedAt     DateTime?
  processingCompletedAt   DateTime?
  processingError          String?           @db.VarChar(2000)  // Was TEXT, limited
  
  // Extraction (Reference to cache, don't store here)
  extractionDataId        String?           @unique  // Reference to ExtractionDataCache
  extractionConfidence    Int?
  pageCount               Int?
  
  // Metadata
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  
  // Relations
  deal                    Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  extractionDataCache     ExtractionDataCache? @relation(fields: [extractionDataId], references: [id])
  extractionJobs          ExtractionJob[]
  corrections             ExtractionCorrection[]

  @@index([dealId])
  @@index([documentType])
  @@index([dealId, documentType])  // Composite index
  @@index([processingStatus])
  @@map("documents")
}

// ============================================================================
// EXTRACTION DATA CACHE (Cost Optimization: Single source of truth)
// ============================================================================

model ExtractionDataCache {
  id            String    @id @default(uuid())
  documentId    String    @unique
  
  // Store extraction data once (not duplicated in documents/extraction_jobs)
  extractionData Json     // JSONB in PostgreSQL
  compressedData Bytes?   // Optional compressed version for very large data
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  document      Document  @relation

  @@index([documentId])
  @@map("extraction_data_cache")
}

// ============================================================================
// EXTRACTION JOBS (Optimized: Reference document, don't duplicate data)
// ============================================================================

model ExtractionJob {
  id                    String              @id @default(uuid())
  dealId                String
  
  // Status
  status                ExtractionJobStatus  @default(PENDING)
  startedAt             DateTime?
  completedAt           DateTime?
  errorMessage          String?              @db.VarChar(1000)  // Was TEXT, limited
  
  // Results (Reference document's extraction_data_cache, don't duplicate)
  fieldsRequiringReview String[]            // Array of field names
  overallConfidence     Int?
  
  // Cost Tracking
  llmTokensUsed         Int?
  llmCostCents          Int?
  llmModel              String?             @db.VarChar(50)
  
  // Metadata
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  
  // Relations
  deal                  Deal                @relation(fields: [dealId], references: [id], onDelete: Cascade)
  documents             Document[]
  corrections           ExtractionCorrection[]

  @@index([dealId])
  @@index([status])
  @@index([dealId, status])  // Composite index
  @@map("extraction_jobs")
}

// ============================================================================
// EXTRACTION CORRECTIONS (Small table, minimal optimization needed)
// ============================================================================

model ExtractionCorrection {
  id                String        @id @default(uuid())
  extractionJobId   String
  documentId        String
  userId            String
  
  // Correction Details (Optimized VARCHAR sizes)
  fieldName         String        @db.VarChar(100)
  originalValue     String?       @db.VarChar(5000)  // Was TEXT, limited
  correctedValue    String        @db.VarChar(5000)  // Was TEXT, limited
  originalConfidence Int?
  
  // Context for ML Training
  documentType      DocumentType?
  pageNumber        Int?
  
  createdAt         DateTime      @default(now())
  
  // Relations
  extractionJob     ExtractionJob @relation(fields: [extractionJobId], references: [id])
  document          Document      @relation(fields: [documentId], references: [id])
  user              User          @relation(fields: [userId], references: [id])

  @@index([extractionJobId])
  @@index([documentId])
  @@index([userId])
  @@map("extraction_corrections")
}

// ============================================================================
// ARCHIVE TABLES (For Cost Optimization - Implement in Phase 2)
// ============================================================================

// Note: Archive tables will be created via migration when needed
// They have the same structure as main tables but for old data

