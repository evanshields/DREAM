KIMI_API_KEY=your_kimi_api_key_here
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=moonshot-v1-32k
FRONTEND_URL=http://localhost:5173

# Google OAuth (required for authentication)
# Get this from: https://console.cloud.google.com/apis/credentials
# Create → OAuth 2.0 Client ID → Web application
# Add authorized JS origins: http://localhost:5173, https://your-vercel-url.vercel.app
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Optional: comma-separated list of allowed email addresses
# Leave empty to allow any Google account to sign in
# Example: evan@shieldstone.co,fahd@shieldstone.co,alton@shieldstone.co
ALLOWED_EMAILS=
